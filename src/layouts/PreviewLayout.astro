---
import '../styles/home.css';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import { asset, href } from '../lib/urls';

interface Props {
  locale?: 'en' | 'ar';
  path?: string;
  title?: string;
  body?: string;
}

const { locale = 'en', path = '', title, body } = Astro.props;
const ar = locale === 'ar';
const requested = `/${locale}/${path ? `${path}/` : ''}`;
const logo = asset('assets/brand/bro-petroleum-logo-600.png');

const copy = ar
  ? {
      eyebrow: 'نسخة معاينة',
      title: 'هذه نسخة معاينة.',
      body: 'تم بناء الصفحة الرئيسية بالتصميم الجديد فقط. بقية الصفحات ستُبنى بعد اعتماد التصميم.',
      home: 'العودة إلى الصفحة الرئيسية',
      other: 'English version',
      otherHref: href('en'),
      requested: 'الصفحة المطلوبة',
    }
  : {
      eyebrow: 'Preview build',
      title: 'This is a preview version.',
      body: 'Only the homepage has been rebuilt in the new design so far. The remaining pages will be built once the design is approved.',
      home: 'Back to the homepage',
      other: 'النسخة العربية',
      otherHref: href('ar'),
      requested: 'Requested page',
    };

const heading = title ?? copy.title;
const message = body ?? copy.body;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ar ? 'نسخة معاينة' : 'Preview version'} | BRO Petroleum</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0E2B3B" />
    <link rel="icon" type="image/png" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" />
  </head>
  <body class="bg-surface font-body text-on-surface antialiased">
    <HomeHeader />
    <main class="w-full bg-surface min-h-[calc(100vh-80px)] pt-20 lg:pt-24">
      <section class="relative w-full bg-pure-white min-h-[calc(100vh-5rem)] flex items-center justify-center py-24 lg:py-32 overflow-hidden">
        <div class="absolute inset-0 opacity-[0.06] pointer-events-none bg-[radial-gradient(#163D52_1px,transparent_1px)] [background-size:24px_24px]"></div>

        <div class="relative z-10 w-full max-w-[640px] mx-auto px-6 text-center" dir={ar ? 'rtl' : 'ltr'}>
          <div class="inline-block bg-pure-white p-4 rounded-[2px] border border-border-hairline mb-8">
            <img src={logo} alt="BRO Petroleum Services" class="h-12 w-auto object-contain" width="600" height="600" />
          </div>

          <p class="font-eyebrow text-eyebrow uppercase tracking-widest text-[#8A5A00] font-bold flex items-center justify-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-[2px] bg-primary-container"></span>
            {copy.eyebrow}
          </p>

          <h1 class="font-headline-lg text-4xl lg:text-5xl font-semibold text-[#163D52] leading-tight mb-5">
            {heading}
          </h1>

          <p class="font-body text-body text-[#566873] leading-relaxed max-w-lg mx-auto mb-6">
            {message}
          </p>

          {path && (
            <p class="text-[13px] text-[#8BA1AF] mb-10">
              {copy.requested}: <code class="font-mono text-[#163D52]">{requested}</code>
            </p>
          )}

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              class="inline-flex items-center justify-center bg-primary-container text-[#0E2B3B] hover:bg-[#8A5A00] hover:text-pure-white font-semibold text-[15px] px-7 py-3 rounded-[2px] transition-colors"
              href={href(locale)}
            >
              {copy.home}
            </a>
            <a class="text-[15px] text-[#3f6279] hover:text-[#163D52] border-b border-border-hairline hover:border-primary-container transition-colors pb-0.5" href={copy.otherHref}>
              {copy.other}
            </a>
          </div>
        </div>
      </section>
    </main>
    <HomeFooter />
    <script>
      const menuToggle = document.querySelector('[data-menu-toggle]');
      const menuPanel = document.querySelector('[data-mobile-nav]');
      const menuIcon = document.querySelector('[data-menu-icon]');
      menuToggle?.addEventListener('click', () => {
        const open = menuPanel?.classList.toggle('hidden') === false;
        menuToggle.setAttribute('aria-expanded', String(open));
        if (menuIcon) menuIcon.textContent = open ? 'close' : 'menu';
      });
    </script>
  </body>
</html>
