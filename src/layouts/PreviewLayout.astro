---
import { asset, href } from '../lib/urls';

interface Props {
  locale?: 'en' | 'ar';
  path?: string;
  title?: string;
  body?: string;
}

const { locale = 'en', path = '', title, body } = Astro.props;
const ar = locale === 'ar';
const requested = `/${locale}/${path ? `${path}/` : ''}`;
const homeHref = href(locale);
const logo = asset('assets/brand/bro-petroleum-logo-600.png');

const copy = ar
  ? {
      eyebrow: 'نسخة معاينة',
      title: 'هذه نسخة معاينة.',
      body: 'تم بناء الصفحة الرئيسية بالتصميم الجديد فقط. بقية الصفحات ستُبنى بعد اعتماد التصميم.',
      home: 'العودة إلى الصفحة الرئيسية',
      other: 'English version',
      otherHref: href('en'),
      requested: 'الصفحة المطلوبة',
    }
  : {
      eyebrow: 'Preview build',
      title: 'This is a preview version.',
      body: 'Only the homepage has been rebuilt in the new design so far. The remaining pages will be built once the design is approved.',
      home: 'Back to the homepage',
      other: 'النسخة العربية',
      otherHref: href('ar'),
      requested: 'Requested page',
    };

const heading = title ?? copy.title;
const message = body ?? copy.body;
---

<!doctype html>
<html lang={locale} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ar ? 'نسخة معاينة' : 'Preview version'} | BRO Petroleum</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@600&display=swap" />
  </head>
  <body>
    <main>
      <div class="mark">
        <img src={logo} alt="BRO Petroleum Services" width="600" height="600" />
      </div>
      <p class="eyebrow"><span class="dot"></span>{copy.eyebrow}</p>
      <h1>{heading}</h1>
      <p class="body">{message}</p>
      {path && <p class="requested">{copy.requested}: <code>{requested}</code></p>}
      <div class="actions">
        <a class="button" href={homeHref}>{copy.home}</a>
        <a class="link" href={copy.otherHref}>{copy.other}</a>
      </div>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    background: #ffffff;
    color: #0d1d27;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  main {
    width: 100%;
    max-width: 34rem;
    text-align: center;
  }

  .mark img {
    height: 3.5rem;
    width: auto;
    object-fit: contain;
    margin: 0 auto 2rem;
    display: block;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A5A00;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: #EFAB3E;
  }

  h1 {
    font-family: 'IBM Plex Serif', Georgia, serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #163D52;
    margin: 0 0 1rem;
  }

  .body {
    font-size: 1rem;
    line-height: 1.6;
    color: #566873;
    margin: 0 0 1.5rem;
  }

  .requested {
    font-size: 0.8125rem;
    color: #8BA1AF;
    margin: 0 0 2rem;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #163D52;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: #EFAB3E;
    color: #0E2B3B;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .button:hover {
    background: #8A5A00;
    color: #ffffff;
  }

  .link {
    color: #3f6279;
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid #D5DCE0;
    padding-bottom: 1px;
  }

  .link:hover {
    color: #163D52;
    border-color: #EFAB3E;
  }
</style>
