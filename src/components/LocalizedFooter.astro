---
import type { Locale } from '../lib/localized';
import { localePath, services, t } from '../lib/localized';
import Logo from './Logo.astro';
const { locale } = Astro.props as { locale: Locale };
const ar = locale === 'ar';
---
<footer class="footer"><div class="container footer-grid"><div><a href={localePath(locale)} aria-label={ar ? 'الرئيسية' : 'Home'}><Logo class="logo--footer" /></a><p class="section-actions placeholder">{ar ? '[وصف الشركة بانتظار اعتماد BRO]' : '[Company description pending BRO approval]'}</p><p class="placeholder">{ar ? '[وسائل التواصل الاجتماعي بانتظار الاعتماد]' : '[Social links pending approval]'}</p></div><div><h3>{ar ? 'التنقل' : 'Navigate'}</h3><div class="footer-links"><a href={localePath(locale, 'about')}>{ar ? 'من نحن' : 'About'}</a><a href={localePath(locale, 'services')}>{ar ? 'الخدمات' : 'Services'}</a><a href={localePath(locale, 'projects')}>{ar ? 'المشاريع' : 'Projects'}</a><a href={localePath(locale, 'hseq')}>HSEQ</a><a href={localePath(locale, 'careers')}>{ar ? 'الوظائف' : 'Careers'}</a><a href={localePath(locale, 'contact')}>{ar ? 'اتصل بنا' : 'Contact'}</a></div></div><div><h3>{ar ? 'الخدمات' : 'Services'}</h3><div class="footer-links">{services.map((service) => <a href={localePath(locale, `services/${service.slug}`)}>{t(service.title, locale)}</a>)}</div></div><div><h3>{ar ? 'بيانات الاتصال' : 'Contact'}</h3><div class="footer-links"><span class="placeholder">[Phone pending BRO approval]</span><span class="placeholder">[WhatsApp pending BRO approval]</span><span class="placeholder">[Email pending BRO approval]</span><a href={localePath(locale, 'privacy')}>{ar ? 'الخصوصية' : 'Privacy'}</a><a href={localePath(locale, 'terms')}>{ar ? 'الشروط' : 'Terms'}</a><a href={localePath(locale)}>{ar ? 'العربية' : 'English'} / {ar ? 'English' : 'العربية'}</a></div></div></div><div class="container footer__bottom"><span>© {new Date().getFullYear()} BRO Petroleum Services</span><span><a href={localePath(locale, 'privacy')}>{ar ? 'الخصوصية' : 'Privacy'}</a> · <a href={localePath(locale, 'terms')}>{ar ? 'الشروط' : 'Terms'}</a></span></div></footer>
