---
import type { Locale } from '../lib/localized';
import { localePath } from '../lib/localized';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
const { locale, path = '' } = Astro.props as { locale: Locale; path?: string };
const current = (target: string) => path === target ? 'page' : undefined;
const labels = locale === 'ar' ? { home: 'الرئيسية', about: 'من نحن', services: 'الخدمات', projects: 'المشاريع', hseq: 'HSEQ', careers: 'الوظائف', contact: 'اتصل بنا', quote: 'طلب عرض سعر', menu: 'القائمة' } : { home: 'Home', about: 'About', services: 'Services', projects: 'Projects', hseq: 'HSEQ', careers: 'Careers', contact: 'Contact', quote: 'Request a quote', menu: 'Menu' };
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={localePath(locale)} aria-label={locale === 'ar' ? 'الرئيسية - BRO Petroleum Services' : 'BRO Petroleum Services home'}><Logo variant="shadow" class="logo--header" /></a>
    <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="primary-navigation">{labels.menu}</button>
    <nav class="nav-links" id="primary-navigation" data-nav aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Primary navigation'}>
      <a aria-current={current('')} href={localePath(locale)}>{labels.home}</a><a aria-current={current('about')} href={localePath(locale, 'about')}>{labels.about}</a><a aria-current={current('services')} href={localePath(locale, 'services')}>{labels.services}</a><a aria-current={current('projects')} href={localePath(locale, 'projects')}>{labels.projects}</a><a aria-current={current('hseq')} href={localePath(locale, 'hseq')}>{labels.hseq}</a><a aria-current={current('careers')} href={localePath(locale, 'careers')}>{labels.careers}</a><a aria-current={current('contact')} href={localePath(locale, 'contact')}>{labels.contact}</a>
      <LanguageSwitcher locale={locale} />
      <a class="button button--primary" data-track="rfq_cta" href={`${localePath(locale, 'contact')}#rfq`}>{labels.quote}</a>
    </nav>
  </div>
</header>
