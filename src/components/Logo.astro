---
interface Props { variant?: 'default' | 'shadow'; class?: string; }
const { variant = 'default', class: className = '' } = Astro.props;
---
<img class:list={['logo', `logo--${variant}`, className]} src="/assets/brand/bro-petroleum-logo.webp" width="1199" height="583" alt="BRO Petroleum Services" decoding="async" />
