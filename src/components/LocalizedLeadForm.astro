---
import type { Locale } from '../lib/localized';
import { services, t } from '../lib/localized';
const { locale, kind = 'rfq', prefill = '' } = Astro.props as { locale: Locale; kind?: 'rfq' | 'career'; prefill?: string };
const ar = locale === 'ar';
const isCareer = kind === 'career';
---
<form class="form" data-lead-form data-endpoint={isCareer ? '/api/recruitment' : '/api/rfq'} enctype={isCareer ? 'multipart/form-data' : undefined}>
  <div class="form__status" data-form-status hidden role="status"></div>
  {isCareer ? <div class="form-grid"><div class="field"><label for="fullName">{ar ? 'الاسم الكامل' : 'Full name'}</label><input id="fullName" name="fullName" required autocomplete="name" /></div><div class="field"><label for="phone">{ar ? 'الهاتف / واتساب' : 'Phone / WhatsApp'}</label><input id="phone" name="phone" required autocomplete="tel" /></div><div class="field"><label for="email">{ar ? 'البريد الإلكتروني' : 'Email'}</label><input id="email" name="email" required type="email" autocomplete="email" /></div><div class="field"><label for="position">{ar ? 'الوظيفة' : 'Position'}</label><input id="position" name="position" required /></div><div class="field"><label for="experience">{ar ? 'سنوات الخبرة' : 'Years of experience'}</label><input id="experience" name="experience" required type="number" min="0" max="70" /></div><div class="field"><label for="certifications">{ar ? 'الشهادات' : 'Certifications'}</label><input id="certifications" name="certifications" required /></div><div class="field field--full"><label for="cv">{ar ? 'السيرة الذاتية PDF أو DOCX' : 'CV PDF or DOCX'}</label><input id="cv" name="cv" required type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" /></div><div class="field field--full"><label><input name="consent" required type="checkbox" /> {ar ? 'أوافق على مراجعة طلبي من قبل BRO.' : 'I consent to BRO reviewing this application.'}</label></div></div> : <div class="form-grid"><div class="field"><label for="company">{ar ? 'الشركة' : 'Company'}</label><input id="company" name="company" required autocomplete="organization" /></div><div class="field"><label for="contactName">{ar ? 'اسم جهة الاتصال' : 'Contact name'}</label><input id="contactName" name="contactName" required autocomplete="name" /></div><div class="field"><label for="email">{ar ? 'البريد المهني' : 'Business email'}</label><input id="email" name="email" required type="email" autocomplete="email" /></div><div class="field"><label for="phone">{ar ? 'الهاتف / واتساب' : 'Phone / WhatsApp'}</label><input id="phone" name="phone" required autocomplete="tel" /></div><div class="field"><label for="service">{ar ? 'الخدمة' : 'Service'}</label><select id="service" name="service" required><option value="">{ar ? 'اختر الخدمة' : 'Select a service'}</option>{services.map((service) => <option value={service.slug} selected={prefill === service.slug}>{t(service.title, locale)}</option>)}</select></div><div class="field"><label for="location">{ar ? 'الموقع / الحقل' : 'Location / field'}</label><input id="location" name="location" required /></div><div class="field field--full"><label for="requirements">{ar ? 'وصف المتطلب' : 'Requirement description'}</label><textarea id="requirements" name="requirements" required></textarea></div><div class="field field--full"><label for="attachment">{ar ? 'مرفق اختياري' : 'Optional attachment'}</label><input id="attachment" name="attachment" type="file" /></div><input type="hidden" name="rigClass" value="[To be confirmed]" /><input type="hidden" name="startDate" value="[To be confirmed]" /></div>}
  <button class="button button--primary" type="submit">{isCareer ? (ar ? 'إرسال الطلب' : 'Submit application') : (ar ? 'إرسال طلب عرض السعر' : 'Send RFQ request')}</button>
</form>
<script src="../scripts/forms.ts"></script>
