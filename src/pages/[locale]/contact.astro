---
import LocaleLayout from '../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import DownloadCards from '../../components/DownloadCards.astro'; import LocalizedLeadForm from '../../components/LocalizedLeadForm.astro'; import { locales, type Locale } from '../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path="contact" title={ar ? 'اتصل بنا' : 'Contact'} description={ar ? '[وصف الاتصال بانتظار المراجعة]' : '[Contact description pending approval]'}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'اتصل بنا' : 'Contact' }]} /><div class="eyebrow">{ar ? 'الاتصال التجاري' : 'Commercial contact'}</div><h1 class="page-hero-title">{ar ? 'ابدأ من المتطلب التشغيلي.' : 'Start with the operating requirement.'}</h1><p>{ar ? '[الهاتف والبريد وواتساب والعنوان بانتظار اعتماد BRO]' : '[Phone, email, WhatsApp, and address pending BRO approval]'}</p></div></section><section class="section" id="rfq"><div class="container form-shell"><div><div class="eyebrow">{ar ? 'طلب عرض سعر' : 'Request a quote'}</div><h2 class="section-title">{ar ? 'أرسل موجز الطلب.' : 'Send the request brief.'}</h2><p class="lede section-copy">{ar ? '[سيتم توجيه الطلب إلى المستلمين المعتمدين بعد الإعداد]' : '[The request will route to approved recipients once configured.]'}</p><div class="notice">[Contact details pending BRO approval]</div></div><LocalizedLeadForm locale={locale} /></div></section><section class="section section--tint" id="downloads"><div class="container"><div class="eyebrow">{ar ? 'التنزيلات' : 'Downloads'}</div><h2 class="section-title">{ar ? 'مستندات التأهيل.' : 'Pre-qualification documents.'}</h2><div class="section-actions"><DownloadCards locale={locale} /></div></div></section></LocaleLayout>
