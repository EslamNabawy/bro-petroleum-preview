---
import LocaleLayout from '../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import DownloadCards from '../../components/DownloadCards.astro'; import { locales, type Locale } from '../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path="hseq" title="HSEQ" description={ar ? '[وصف HSEQ بانتظار المراجعة]' : '[HSEQ description pending approval]'}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: 'HSEQ' }]} /><div class="eyebrow">HSEQ</div><h1 class="page-hero-title">{ar ? 'الأدلة أولاً في كل عملية.' : 'Evidence first in every operation.'}</h1><p>{ar ? '[سياسة HSEQ الموقعة والمؤرخة بانتظار اعتماد BRO]' : '[Signed and dated HSEQ policy pending BRO approval]'}</p></div></section><section class="section"><div class="container grid-2"><div><div class="eyebrow">{ar ? 'الشهادات' : 'Certifications'}</div><h2 class="section-title">{ar ? 'بطاقات اعتماد قابلة للمراجعة.' : 'Certification cards for review.'}</h2></div><div class="placeholder-grid"><div class="notice">[Standard] · [Certificate number] · [Issuer] · [Expiry date]</div><div class="notice">[Standard] · [Certificate number] · [Issuer] · [Expiry date]</div><div class="notice">[Document pending BRO approval]</div></div></div></section><section class="section section--dark"><div class="container grid-3"><div class="dark-panel"><h3>{ar ? 'التدريب' : 'Training'}</h3><p>[Training approach pending BRO approval]</p></div><div class="dark-panel"><h3>{ar ? 'الأداء' : 'Performance'}</h3><p>[Metric and period pending evidence]</p></div><div class="dark-panel"><h3>{ar ? 'الاستجابة' : 'Response'}</h3><p>[Emergency response approach pending BRO approval]</p></div></div></section><section class="section"><div class="container"><div class="eyebrow">{ar ? 'المستندات' : 'Documents'}</div><h2 class="section-title">{ar ? 'سياسات للتحميل بعد الاعتماد.' : 'Policies available after approval.'}</h2><div class="section-actions"><DownloadCards locale={locale} /></div></div></section></LocaleLayout>
