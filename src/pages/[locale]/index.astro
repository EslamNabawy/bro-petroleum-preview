---
import LocaleLayout from '../../layouts/LocaleLayout.astro';
import ContentCards from '../../components/ContentCards.astro';
import Icon from '../../components/Icon.astro';
import { locales, localePath, type Locale } from '../../lib/localized';

export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const ar = locale === 'ar';
const showClients = false;
const why = ar ? ['السلامة', 'الاعتمادية', 'العمق الفني', 'القدرة المحلية'] : ['Safety', 'Reliability', 'Technical depth', 'Local capability'];
const stats = ar ? ['سنوات التشغيل', 'المشاريع المنفذة', 'ساعات دون إصابة', 'أعضاء الفريق'] : ['Years in operation', 'Projects delivered', 'Hours without LTI', 'Team members'];
const previewStats = ar ? ['[12+ · معاينة]', '[36 · معاينة]', '[00 · بانتظار التحقق]', '[120 · معاينة]'] : ['[12+ · preview]', '[36 · preview]', '[00 · pending verification]', '[120 · preview]'];
const previewCerts = ar ? ['[ISO 9001 · معاينة · بانتظار التحقق]', '[ISO 14001 · معاينة · بانتظار التحقق]', '[ISO 45001 · معاينة · بانتظار التحقق]'] : ['[ISO 9001 · preview · pending verification]', '[ISO 14001 · preview · pending verification]', '[ISO 45001 · preview · pending verification]'];
---
<LocaleLayout locale={locale} title={ar ? 'خدمات بترولية موثوقة' : 'Petroleum services for critical work'} description={ar ? '[وصف الصفحة الرئيسية بانتظار مراجعة عربية واعتماد BRO]' : '[Homepage description pending BRO approval]'}>
  <section class="hero"><img class="hero__image" src="/assets/backgrounds/Sunset Oilfield Rig and Workers.png" width="1600" height="900" alt={ar ? 'فريق ومعدة حفر في موقع نفطي عند الغروب' : 'Drilling crew and rig at an oilfield site at sunset'} /><div class="container hero__content"><div class="eyebrow">{ar ? 'خدمات بترولية · مصر والمنطقة' : 'Petroleum services · Egypt and MENA'}</div><h1>{ar ? 'شريك ميداني للعمليات التي لا تحتمل التأخير.' : 'Field support for operations that cannot afford delay.'}</h1><p>{ar ? 'دعم عملي للحفر وخدمات الآبار والمعدات والخدمات اللوجستية — بموجز واضح ومسار تنفيذ قابل للمراجعة.' : 'Practical support for drilling, well services, equipment, and logistics — with a clear brief and an execution path your team can review.'}</p><div class="hero__actions"><a class="button button--primary" data-track="rfq_cta" href={`${localePath(locale, 'contact')}#rfq`}>{ar ? 'ابدأ متطلبك' : 'Start your requirement'}</a><a class="button button--secondary" href={`${localePath(locale, 'services')}`}>{ar ? 'استكشف الخدمات' : 'Explore services'}</a></div></div></section>

  <section class="section section--credibility"><div class="container"><div class="section__heading"><div><div class="eyebrow">{ar ? 'المصداقية أولاً' : 'Credibility first'}</div><h2>{ar ? 'معلومات واضحة قبل قرار التأهيل.' : 'Clear information before pre-qualification.'}</h2></div></div><div class="stat-grid credibility-grid">{stats.map((label, index) => <div class="stat"><span class="stat__value placeholder">{previewStats[index].split(' · ')[0]}</span><span class="stat__unit placeholder">{previewStats[index].includes('·') ? `· ${previewStats[index].split(' · ')[1]}` : ''}</span><span class="stat__label">{label}</span></div>)}</div><div class="cert-grid">{previewCerts.map((cert) => <div class="cert-card placeholder">{cert}</div>)}</div></div></section>

  <section class="section section--tint services-section"><div class="container"><div class="section__heading"><div><div class="eyebrow">{ar ? 'الخدمات' : 'Services'}</div><h2>{ar ? 'من المتطلب إلى خطة تنفيذ واضحة.' : 'From operating requirement to a clear delivery plan.'}</h2><p class="lede section-copy">{ar ? 'اختر نقطة البداية، ثم دع فريقك يحدد النطاق والمعدات والأدلة المطلوبة.' : 'Choose the starting point, then define the scope, equipment, and evidence your team needs.'}</p></div></div><div class="section-actions"><ContentCards locale={locale} kind="services" /></div></div></section>

  <section class="section"><div class="container"><div class="section__heading"><div><div class="eyebrow">{ar ? 'لماذا BRO' : 'Why BRO'}</div><h2>{ar ? 'أدلة عملية، لا أوصاف عامة.' : 'Practical proof, not broad adjectives.'}</h2></div></div><div class="grid-4 section-actions">{why.map((title, index) => <article class="why-card"><div class="why-card__topline"></div><Icon name={['shield', 'reliability', 'technical', 'local'][index]} /><h3>{title}</h3><p class="placeholder">{ar ? '[دليل سلوكي بانتظار اعتماد BRO]' : '[Behavior-based proof pending BRO approval]'}</p></article>)}</div></div></section>

  <section class="section section--dark"><div class="container"><div class="section__heading"><div><div class="eyebrow">{ar ? 'المشاريع' : 'Projects'}</div><h2>{ar ? 'نتائج قابلة للمراجعة.' : 'Results that can be reviewed.'}</h2></div><a class="section-link" href={localePath(locale, 'projects')}>{ar ? 'عرض كل المشاريع' : 'View all projects'} <span aria-hidden="true">→</span></a></div><div class="section-actions"><ContentCards locale={locale} kind="projects" /></div></div></section>

  <section class="section section--hseq"><div class="container hseq-grid"><div><div class="eyebrow">HSEQ</div><h2>{ar ? 'الجاهزية تبدأ بالأدلة.' : 'Readiness starts with evidence.'}</h2><p class="lede section-copy">{ar ? 'مسار مقترح لمراجعة السياسات والتدريب والشهادات قبل التأهيل.' : 'A proposed review path for policies, training, and certificates before pre-qualification.'}</p><a class="button button--dark" href={localePath(locale, 'hseq')}>{ar ? 'راجع منهج HSEQ' : 'Review the HSEQ approach'}</a></div><div class="image-slot hseq-slot"><img src="/assets/backgrounds/Refinery Safety Inspection at Dusk.png" alt={ar ? 'تفتيش سلامة في منشأة صناعية' : 'Safety inspection at an industrial facility'} /><span class="image-overlay"></span><span class="placeholder image-caption">[HSEQ image used for preview]</span></div></div></section>

  {showClients && <section class="section"><div class="container"><div class="section__heading"><div><div class="eyebrow">{ar ? 'العملاء والشركاء' : 'Clients and partners'}</div><h2>{ar ? 'علاقات بانتظار الإذن بالنشر.' : 'Relationships pending publication permission.'}</h2></div></div><div class="client-strip">{[1, 2, 3, 4, 5, 6].map(() => <div class="client-tile placeholder">[Logo pending permission]</div>)}</div></div></section>}

  <section class="section section--tint"><div class="container careers-grid"><div><div class="eyebrow">{ar ? 'الوظائف' : 'Careers'}</div><h2>{ar ? 'أضف خبرتك إلى المهمة المناسبة.' : 'Bring your experience to the right assignment.'}</h2><p class="lede section-copy">{ar ? 'إذا كنت تبحث عن عمل ميداني مسؤول، شارك خبرتك وسيراجعها فريق BRO.' : 'If you are looking for responsible field work, share your experience for BRO review.'}</p><a class="button button--dark" href={localePath(locale, 'careers')}>{ar ? 'شارك خبرتك' : 'Share your experience'}</a></div><div class="image-slot careers-slot"><img src="/assets/backgrounds/Engineers Reviewing Tablet at Sunset.png" alt={ar ? 'مهندسون يراجعون بيانات ميدانية' : 'Engineers reviewing field data'} /><span class="image-overlay"></span><span class="placeholder image-caption">[Careers image used for preview]</span></div></div></section>

  <section class="section section--cta"><div class="container cta-grid"><div><div class="eyebrow">{ar ? 'الخطوة التالية' : 'Next step'}</div><h2>{ar ? 'حوّل المتطلب إلى محادثة عملية.' : 'Turn the requirement into a practical conversation.'}</h2><p class="lede section-copy">{ar ? 'أرسل الموقع والنطاق والموعد المتوقع. سنترك الأرقام والوثائق النهائية لاعتماد BRO.' : 'Share the location, scope, and expected timing. Final figures and documents remain subject to BRO approval.'}</p><div class="hero__actions"><a class="button button--primary" data-track="rfq_cta" href={`${localePath(locale, 'contact')}#rfq`}>{ar ? 'طلب عرض سعر' : 'Request a quote'}</a><a class="button button--secondary placeholder" href="#whatsapp">{ar ? 'واتساب' : 'WhatsApp'}</a></div><p class="cta-contact placeholder">{ar ? '[الهاتف بانتظار اعتماد BRO]' : '[Phone pending BRO approval]'}</p></div><div class="image-slot cta-slot"><img src="/assets/backgrounds/Refinery Lights at Blue Hour.png" alt="" /><span class="image-overlay"></span></div></div></section>
</LocaleLayout>
