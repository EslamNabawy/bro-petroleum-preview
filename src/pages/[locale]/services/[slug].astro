---
import LocaleLayout from '../../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import LocalizedLeadForm from '../../../components/LocalizedLeadForm.astro'; import { locales, services, t, type Locale } from '../../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.flatMap((locale: Locale) => services.map((service: typeof services[number]) => ({ params: { locale, slug: service.slug }, props: { locale, service } }))); }
const { locale, service } = Astro.props as { locale: Locale; service: typeof services[number] }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path={`services/${service.slug}`} title={t(service.title, locale)} description={t(service.outcome, locale)}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'الخدمات' : 'Services', path: 'services' }, { label: t(service.title, locale) }]} /><div class="eyebrow">{ar ? 'خدمة' : 'Service'}</div><h1 class="page-hero-title">{t(service.title, locale)}</h1><p>{t(service.outcome, locale)}</p></div></section><section class="section"><div class="container grid-2"><div><div class="eyebrow">{ar ? 'النطاق' : 'Scope'}</div><h2 class="section-title">{ar ? 'ما الذي يحتاجه العميل؟' : 'What the client needs.'}</h2><p class="lede section-copy">{t(service.scope, locale)}</p><div class="notice">{ar ? '[المعدات والكوادر والطاقة الاستيعابية بانتظار اعتماد BRO]' : '[Equipment, personnel, and capacity pending BRO approval]'}</div></div><div class="panel feature-panel"><div class="eyebrow">{ar ? 'المعايير وHSEQ' : 'Standards and HSEQ'}</div><ul class="check-list"><li>[Applicable standards pending approval]</li><li>[HSEQ approach pending approval]</li><li>[Related project evidence pending approval]</li></ul></div></div></section><section class="section section--tint"><div class="container grid-2"><div><div class="eyebrow">FAQ</div><h2 class="section-title">{ar ? 'أسئلة قبل التأهيل.' : 'Questions before pre-qualification.'}</h2></div><div class="placeholder-grid">{service.faq.map((item) => <details class="notice"><summary>{t(item.q, locale)}</summary><p class="section-actions">{t(item.a, locale)}</p></details>)}</div></div></section><section class="section"><div class="container form-shell"><div><div class="eyebrow">{ar ? 'طلب عرض سعر' : 'Request a quote'}</div><h2 class="section-title">{ar ? 'أرسل متطلب هذه الخدمة.' : 'Send the requirement for this service.'}</h2><p class="lede section-copy">{ar ? '[بيانات الاتصال بانتظار اعتماد BRO]' : '[Contact details pending BRO approval]'}</p></div><LocalizedLeadForm locale={locale} prefill={service.slug} /></div></section></LocaleLayout>
