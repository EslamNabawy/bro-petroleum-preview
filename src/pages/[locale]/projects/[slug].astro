---
import LocaleLayout from '../../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import { locales, projects, t, type Locale, localePath } from '../../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.flatMap((locale: Locale) => projects.map((project: typeof projects[number]) => ({ params: { locale, slug: project.slug }, props: { locale, project } }))); }
const { locale, project } = Astro.props as { locale: Locale; project: typeof projects[number] }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path={`projects/${project.slug}`} title={t(project.title, locale)} description={t(project.result, locale)}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'المشاريع' : 'Projects', path: 'projects' }, { label: t(project.title, locale) }]} /><div class="eyebrow">{t(project.clientType, locale)}</div><h1 class="page-hero-title">{t(project.title, locale)}</h1><p>{t(project.region, locale)} · [Duration pending BRO approval]</p></div></section><section class="section"><div class="container grid-2"><div class="placeholder-grid"><div class="notice">[Challenge pending approval]</div><div class="notice">[Action pending approval]</div><div class="notice">{t(project.result, locale)}</div></div><div class="panel feature-panel"><div class="eyebrow">{ar ? 'السلامة' : 'Safety performance'}</div><p class="section-copy">[Period-labeled safety performance pending evidence]</p><div class="field-gallery project-gallery"><figure><img src="/assets/backgrounds/Engineers Reviewing Tablet at Sunset.png" width="1600" height="900" alt="[Project image pending BRO approval]" /></figure><figure><img src="/assets/backgrounds/Refinery Safety Inspection at Dusk.png" width="1600" height="900" alt="[Project image pending BRO approval]" /></figure></div></div></div></section><section class="section section--dark"><div class="container"><div class="eyebrow">{ar ? 'الخدمة المرتبطة' : 'Related service'}</div><h2 class="section-title">{ar ? '[الخدمة بانتظار اعتماد BRO]' : '[Related service pending BRO approval]'}</h2><a class="button button--primary source-note-button" href={localePath(locale, 'services')}>{ar ? 'عرض الخدمات' : 'View services'}</a></div></section></LocaleLayout>
