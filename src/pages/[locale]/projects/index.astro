---
import LocaleLayout from '../../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import ContentCards from '../../../components/ContentCards.astro'; import { locales, type Locale } from '../../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path="projects" title={ar ? 'المشاريع' : 'Projects'} description={ar ? '[وصف المشاريع بانتظار المراجعة]' : '[Projects description pending approval]'}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'المشاريع' : 'Projects' }]} /><div class="eyebrow">{ar ? 'المشاريع' : 'Projects'}</div><h1 class="page-hero-title">{ar ? 'نتائج موثقة، لا شعارات.' : 'Evidence before logos.'}</h1><p>{ar ? '[ملخص المشاريع والنتائج بانتظار اعتماد BRO]' : '[Project summary and results pending BRO approval]'}</p></div></section><section class="section"><div class="container"><ContentCards locale={locale} kind="projects" /></div></section></LocaleLayout>
