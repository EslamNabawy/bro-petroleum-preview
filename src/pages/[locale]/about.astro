---
import LocaleLayout from '../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import DownloadCards from '../../components/DownloadCards.astro'; import { locales, type Locale } from '../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path="about" title={ar ? 'من نحن' : 'About BRO'} description={ar ? '[وصف من نحن بانتظار المراجعة]' : '[About description pending approval]'}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'من نحن' : 'About' }]} /><div class="eyebrow">{ar ? 'من نحن' : 'About'}</div><h1 class="page-hero-title">{ar ? 'شركة تُراجع على أساس ما تثبته.' : 'A company reviewed by what it can evidence.'}</h1><p>{ar ? '[قصة الشركة بانتظار اعتماد BRO ومراجعة عربية]' : '[Approximately 200-word company story pending BRO approval]'}</p></div></section><section class="section"><div class="container grid-2"><div><div class="eyebrow">{ar ? 'المسار' : 'Milestones'}</div><h2 class="section-title">{ar ? 'محطات بانتظار التوثيق.' : 'Milestones to be documented.'}</h2></div><div class="placeholder-grid"><div class="notice">[Milestone and date pending BRO approval]</div><div class="notice">[Milestone and date pending BRO approval]</div><div class="notice">[Milestone and date pending BRO approval]</div></div></div></section><section class="section section--dark"><div class="container grid-2"><div><div class="eyebrow">{ar ? 'القيادة والقيم' : 'Leadership and values'}</div><h2 class="section-title">{ar ? 'سلوكيات واضحة، أسماء معتمدة.' : 'Clear behaviours, approved names.'}</h2></div><div class="dark-panel"><p>[Leadership, registration, license, and values evidence pending BRO approval]</p></div></div></section><section class="section"><div class="container"><div class="eyebrow">{ar ? 'المستندات' : 'Documents'}</div><h2 class="section-title">{ar ? 'ملفات يمكن مراجعتها.' : 'Documents for review.'}</h2><div class="section-actions"><DownloadCards locale={locale} /></div></div></section></LocaleLayout>
