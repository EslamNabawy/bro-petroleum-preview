---
import LocaleLayout from '../../layouts/LocaleLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LocalizedLeadForm from '../../components/LocalizedLeadForm.astro'; import { locales, type Locale } from '../../lib/localized';
export const prerender = true;
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale }; const ar = locale === 'ar';
---
<LocaleLayout locale={locale} path="careers" title={ar ? 'الوظائف' : 'Careers'} description={ar ? '[وصف الوظائف بانتظار المراجعة]' : '[Careers description pending approval]'}><section class="page-hero"><div class="container"><Breadcrumbs locale={locale} items={[{ label: ar ? 'الوظائف' : 'Careers' }]} /><div class="eyebrow">{ar ? 'الوظائف' : 'Careers'}</div><h1 class="page-hero-title">{ar ? 'خبرة ميدانية للمهمة المناسبة.' : 'Field experience for the right assignment.'}</h1><p>{ar ? '[وصف بيئة العمل بانتظار اعتماد BRO]' : '[Why work at BRO copy pending BRO approval]'}</p></div></section><section class="section"><div class="container grid-2"><div><div class="eyebrow">{ar ? 'الفرص الحالية' : 'Open roles'}</div><h2 class="section-title">{ar ? 'وظائف بانتظار اعتماد BRO.' : 'Roles pending BRO approval.'}</h2></div><div class="placeholder-grid"><div class="notice">[Job title] · [Location] · [Requirements pending approval]</div><div class="notice">[Job title] · [Location] · [Requirements pending approval]</div></div></div></section><section class="section section--tint"><div class="container form-shell"><div><div class="eyebrow">{ar ? 'طلب عام' : 'General application'}</div><h2 class="section-title">{ar ? 'أرسل بياناتك للمراجعة البشرية.' : 'Send your details for human review.'}</h2><p class="lede section-copy">{ar ? '[لا يتم اتخاذ أي قرار توظيف آلياً]' : '[Every hiring decision is made by a human reviewer.]'}</p></div><LocalizedLeadForm locale={locale} kind="career" /></div></section></LocaleLayout>
