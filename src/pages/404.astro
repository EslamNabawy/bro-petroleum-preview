---
import LocaleLayout from '../layouts/LocaleLayout.astro';
---
<LocaleLayout locale="en" title="Page not found" description="The requested BRO Petroleum Services page could not be found.">
  <section class="page-hero">
    <div class="container text-container">
      <p class="eyebrow">404</p>
      <h1>This page is not in the operational record.</h1>
      <p>Return to the homepage or review our services.</p>
      <div class="hero-actions">
        <a class="button button--primary" href="/en/">Go home</a>
        <a class="button button--secondary" href="/en/services/">View services</a>
      </div>
    </div>
  </section>
</LocaleLayout>
