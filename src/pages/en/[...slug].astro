---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import { previewPaths } from '../../lib/preview-paths';

export function getStaticPaths() {
  return previewPaths.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<PreviewLayout locale="en" path={slug ?? ''} />
